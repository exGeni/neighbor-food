{
  "name": "neighbor-food",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Share home-made food with the neighbours in your building. A page behind a QR code.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:emulator": "node scripts/dev-emulator.mjs",
    "build": "tsc --noEmit && vite build && node scripts/budget.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "node scripts/with-emulator.mjs \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "node scripts/with-emulator.mjs \"node scripts/e2e.mjs\"",
    "check:live": "node scripts/check-live.mjs"
  },
  "dependencies": {
    "@fontsource/balsamiq-sans": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "firebase": "^13.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "@types/qrcode": "^1.5.6",
    "firebase-tools": "^15.37.0",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
